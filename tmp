  <script>
    // highlight the section being read in the sidebar
    (function () {
      var links = Array.prototype.slice.call(document.querySelectorAll(".sidebar nav a"));
      if (!links.length) { return; }
      var targets = links.map(function (link) {
        return document.getElementById(link.getAttribute("href").slice(1));
      });
      function update() {
        var current = 0;
        for (var i = 0; i < targets.length; i++) {
          if (targets[i] && targets[i].getBoundingClientRect().top <= 120) { current = i; }
        }
        // the last sections may be too short to ever reach the top of the page
        if (window.innerHeight + window.pageYOffset >= document.documentElement.scrollHeight - 2) {
          current = links.length - 1;
        }
        links.forEach(function (link, i) { link.classList.toggle("active", i === current); });
      }
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
      update();
    })();
  </script>
